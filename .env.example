# Copy to .env and fill in. This service reads its own .env and nothing else.
#
# To layer the Rust service's .env (services/nanoSolve-backend/.env) underneath this one
# instead of duplicating the keys:  export MNP_ALLOW_SIBLING_ENV=1
# To point somewhere else entirely, replacing the search:  export MNP_ENV_FILE=/path/to/.env
# The shell always wins over any file.

# Europe PMC asks for a contact address in the User-Agent. Fetching refuses to run without it.
MNP_CONTACT_EMAIL=you@example.org

# The work queue's own database. There is deliberately no fall-back to DATABASE_URL:
# that belongs to the Rust service, and the queue must never write into the application's DB.
# `./tool/test_db.sh up` prints a throwaway one.
MNP_DB_URL=postgresql://mnp:mnp@localhost:55432/mnp

# LLM extraction (the API path). The subagent path needs none of these.
OPENROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Comma-separated; tried in order on 429 or 5xx.
OPENROUTER_FALLBACK_MODELS=
# Overrides the chain above outright when set.
MNP_MODEL_CHAIN=
